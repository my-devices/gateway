<!DOCTYPE HTML>
<%@ page class="TOTPPage"
  namespace="MyDevices::Gateway"
  contentType="text/html;charset=utf-8"
  compressed="true"
  context="DeviceManager::Ptr" %>

<%@ header include="DeviceManager.h" %>
<%@ impl include="LoginPageController.h" %>
<%@ include file="../html/template.inc" %>

<%%
LoginPageController ctrl(context(), request, form);
if (ctrl.mustRedirect()) return;

pageTemplate.set("title"s, "Gateway"s);
%>

<%@ include file="../html/header.inc" %>

<% if (!ctrl.message().empty()) { %>
  <div class="error">
    <%= U::htmlize(ctrl.message()) %>
  </div>
<% } %>

<div class="loginBox">
  <form method="post" action="/totp" accept-charset="utf-8">
    <table>
      <tr>
        <th colspan="2" id="notice">
          Please enter the one-time password generated by your authenticator app.
        </th>
      </tr>
      <tr>
        <th id="usernameLabelCell">Username:</th>
        <td id="usernameInputCell"><%= ctrl.totpUsername() %></td>
      </tr>
      <tr>
        <th id="totpLabelCell">One-time Password:</th>
        <td id="totpInputCell"><input id="totpInput" type="text" name="totp" autofocus></td>
      </tr>
      <tr>
        <td>&nbsp;</td>
        <td id="loginButtonCell">
          <input type="hidden" name="action" value="totp">
          <input id="loginButton" type="submit" name="accept" value="Login">
		  &nbsp;
		  <a href="/">Cancel</a>
        </td>
      </tr>
    </table>
    <input type="hidden" name="operation" value="login">
  </form>
</div>

<%@ include file="../html/footer.inc" %>
